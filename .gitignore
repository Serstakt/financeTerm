```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyc.*
*.pyo.*
.Python
venv/
.venv/
.env
.env.local
.env.*

# Node.js/JavaScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
dist/
build/
*.min.js
*.min.css

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
*.tmp

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Coverage reports
coverage/
htmlcov/
.coverage
```